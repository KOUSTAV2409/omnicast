#!/usr/bin/env bash
CONFIG_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/../src" && pwd)"

# Try to toggle existing running instance via IPC
if quickshell ipc -p "$CONFIG_PATH" call omnicast toggle 2>/dev/null; then
    exit 0
fi

# If not responding, ensure old dead process is cleaned and daemonize
pkill -f "$CONFIG_PATH" 2>/dev/null || true
quickshell -p "$CONFIG_PATH" -d
sleep 0.25
quickshell ipc -p "$CONFIG_PATH" call omnicast show 2>/dev/null || true
