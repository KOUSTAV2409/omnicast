# Maintainer: Koustav Ganguly <koustavganguly24@gmail.com>
# OPR recipe scaffold — copy into omacom/omarchy-pkgs pkgbuilds/omnicast/
# Pin _commit before opening a PR (omarchy-pkgs rejects unpinned git sources).

pkgname=omnicast
pkgver=0.2.1
pkgrel=1
pkgdesc="Alt+Space productivity umbrella for Omarchy (Hyprland / Quickshell)"
arch=('any')
url="https://omnicast.best"
license=('MIT')
depends=(
    'quickshell'
    'python'
    'wl-clipboard'
    'xdg-utils'
)
optdepends=(
    'fd: fast file name search'
    'ripgrep: content: file search'
    'plocate: locate-backed file search'
    'ghostty: default terminal'
    'imv: image preview'
    'onlyoffice-desktopeditors: office document viewer'
)
# REPLACE with the exact commit you are packaging, then run updpkgsums.
_commit=REPLACE_WITH_GIT_SHA
source=("git+https://github.com/KOUSTAV2409/omnicast.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
    cd "$srcdir/omnicast"

    install -d "$pkgdir/usr/share/omnicast"
    cp -a src bin BarWidget.qml manifest.json LICENSE README.md \
        "$pkgdir/usr/share/omnicast/"

    # Do not ship marketing video, site, or draft packaging trees
    rm -rf "$pkgdir/usr/share/omnicast/bin/__pycache__" 2>/dev/null || true

    install -d "$pkgdir/usr/bin"
    ln -sf /usr/share/omnicast/bin/omnicast "$pkgdir/usr/bin/omnicast"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/omnicast.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Omnicast
Comment=Alt+Space Productivity Umbrella for Omarchy
Exec=omnicast %u
Icon=preferences-system-search
Terminal=false
Type=Application
Categories=Utility;System;
MimeType=x-scheme-handler/omnicast;
StartupNotify=false
DESKTOP

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
