# Maintainer: Koustav Ganguly <koustavganguly24@gmail.com>
pkgname=omnicast-git
pkgver=0.2.0.r1.g$(git rev-parse --short HEAD 2>/dev/null || echo "1")
pkgrel=1
pkgdesc="Raycast-grade Alt+Space productivity umbrella for Omarchy on Wayland"
arch=('any')
url="https://omnicast.best"
license=('MIT')
depends=('quickshell' 'python' 'git' 'wl-clipboard')
optdepends=(
    'ghostty: default terminal editor wrapper'
    'imv: image preview viewer'
    'onlyoffice-desktopeditors: office document viewer'
    'python-evdev: global snippet expansion daemon'
)
provides=('omnicast')
conflicts=('omnicast')
source=("git+https://github.com/KOUSTAV2409/omnicast.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/omnicast"
    git describe --long --tags --always 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.2.0"
}

package() {
    cd "$srcdir/omnicast"
    
    install -d "$pkgdir/usr/share/omnicast"
    cp -r src bin docs "$pkgdir/usr/share/omnicast/"
    
    install -d "$pkgdir/usr/bin"
    ln -sf "/usr/share/omnicast/bin/omnicast" "$pkgdir/usr/bin/omnicast"
    
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
