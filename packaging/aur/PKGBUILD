# Maintainer: Koustav Ganguly <koustavganguly24@gmail.com>
pkgname=omnicast-git
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="Alt+Space productivity umbrella for Omarchy (Hyprland / Quickshell)"
arch=('any')
url="https://omnicast.best"
license=('MIT')
depends=(
    'quickshell'
    'python'
    'wl-clipboard'
    'xdg-utils'
)
optdepends=(
    'fd: fast file name search'
    'ripgrep: content: file search'
    'plocate: locate-backed file search'
    'ghostty: default terminal'
    'imv: image preview'
    'onlyoffice-desktopeditors: office document viewer'
    'gtk3: gtk-launch for .desktop apps'
)
makedepends=('git')
provides=('omnicast')
conflicts=('omnicast')
source=("git+https://github.com/KOUSTAV2409/omnicast.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/omnicast"
    local desc
    desc=$(git describe --long --tags --always 2>/dev/null || true)
    if [[ -n $desc ]]; then
        printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.2.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

package() {
    cd "$srcdir/omnicast"

    install -d "$pkgdir/usr/share/omnicast"
    cp -a src bin docs manifest.json BarWidget.qml LICENSE README.md \
        "$pkgdir/usr/share/omnicast/"

    # Keep install helper available but do not auto-run it from packaging.
    install -Dm755 install.sh "$pkgdir/usr/share/omnicast/install.sh"

    install -d "$pkgdir/usr/bin"
    ln -sf /usr/share/omnicast/bin/omnicast "$pkgdir/usr/bin/omnicast"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
